#!/usr/bin/env bash
# Runs a command against a headless X server, so a test that needs a display -
# an X11 Window with a real id, a GPUView presenting through a swapchain over
# VK_KHR_xcb_surface - runs on a machine with no display at all. Xvfb has no
# window manager, which is the harshest case a toplevel meets and the one CI
# should be looking at; it does have a seat, so XTest input works here as it
# does not under Weston.
#
#   Scripts/with-xvfb ctest --test-dir build --output-on-failure
#
# EACP_HEADLESS is deliberately not set here: a test binary that wants to open
# windows runs with it unset (or 0), and EACP_REQUIRE_DISPLAY=1 makes such a
# test fail rather than self-skip when no display is found. The same script is
# what the CI Vulkan lane and the Docker image (`with-xvfb`) run.
set -euo pipefail

output_width=1280
output_height=800

# How a test tells it is looking at this output rather than at whatever a real
# desktop happens to be, exactly as EACP_WESTON_OUTPUT does for Weston.
export EACP_XVFB_OUTPUT="${output_width}x${output_height}"

# The X11 backend is the point of the session; a compositor the tests must not
# reach back to is worse than none at all.
export EACP_WINDOW_SYSTEM=x11
unset WAYLAND_DISPLAY WAYLAND_SOCKET || true

# From 90 upward, so a desktop's own :0 and any nested server are left alone.
display=""

for number in $(seq 90 99); do
    if [ ! -e "/tmp/.X${number}-lock" ] && [ ! -e "/tmp/.X11-unix/X${number}" ]; then
        display="$number"
        break
    fi
done

if [ -z "$display" ]; then
    echo "with-xvfb: no free display number between :90 and :99" >&2
    exit 1
fi

log="${EACP_XVFB_LOG:-/tmp/xvfb.log}"

Xvfb ":$display" -screen 0 "${output_width}x${output_height}x24" -nolisten tcp \
    >"$log" 2>&1 &
pid=$!
trap 'kill $pid 2>/dev/null || true' EXIT

for _ in $(seq 1 100); do
    [ -S "/tmp/.X11-unix/X${display}" ] && break
    sleep 0.1
done

if [ ! -S "/tmp/.X11-unix/X${display}" ]; then
    echo "with-xvfb: Xvfb did not come up" >&2
    cat "$log" >&2
    exit 1
fi

export DISPLAY=":$display"

"$@"
