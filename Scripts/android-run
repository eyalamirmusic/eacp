#!/usr/bin/env bash
# Usage: android-run <sdk> <apk> <package>
#
# Installs and launches an eacp APK on the device adb sees, booting an emulator
# first when none is attached: $EACP_AVD, or else the first AVD the emulator
# lists. Prints the app's first seconds of logcat (tag "eacp", plus any crash).
set -euo pipefail

sdk="$1"
apk="$2"
package="$3"
adb="$sdk/platform-tools/adb"
emulator="$sdk/emulator/emulator"

if ! "$adb" get-state >/dev/null 2>&1; then
    avd="${EACP_AVD:-$("$emulator" -list-avds | head -n 1)}"

    if [[ -z "$avd" ]]; then
        echo "no device attached and no AVD to boot: create one with avdmanager" >&2
        exit 1
    fi

    echo "booting emulator $avd" >&2
    if command -v cygpath >/dev/null; then
        # Windows: a child inherits ninja's output pipe, and ninja waits for
        # it to close, so the emulator starts through Start-Process instead.
        powershell -NoProfile -Command "Start-Process -FilePath '$(cygpath -w "$emulator.exe")' \
            -ArgumentList '-avd $avd -no-snapshot-save -no-audio -gpu host'"
    else
        nohup "$emulator" -avd "$avd" -no-snapshot-save -no-audio -gpu host \
            >/dev/null 2>&1 &
    fi
    "$adb" wait-for-device

    until [[ "$("$adb" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == 1 ]]; do
        sleep 2
    done
fi

"$adb" install -r "$apk"
"$adb" shell am force-stop "$package"
"$adb" logcat -c
"$adb" shell am start -n "$package/android.app.NativeActivity"

sleep "${EACP_RUN_LOG_SECONDS:-3}"
"$adb" logcat -d -s eacp AndroidRuntime DEBUG
echo "running $package; follow its log with: $adb logcat -s eacp" >&2
