#!/usr/bin/env bash
# Usage: android-apk <sdk> <build-tools version> <platform> <manifest>
#                    <library> <abi> <out.apk> [res dir] [debug]
#
# Packages one native library behind a NativeActivity manifest, with no Gradle:
# aapt2 links the manifest (and any resources), the library goes in under
# lib/<abi>/, then zipalign and apksigner with the debug keystore. "debug"
# marks the app debuggable, for run-as and a debugger to attach.
set -euo pipefail

sdk="$1"
build_tools="$sdk/build-tools/$2"
platform_jar="$sdk/platforms/$3/android.jar"
manifest="$4"
library="$5"
abi="$6"
out="$7"
res="${8:-}"
debug="${9:-}"

# macOS ships a /usr/bin/java stub that fails without a JDK installed.
if [[ -z "${JAVA_HOME:-}" ]] && ! java -version >/dev/null 2>&1; then
    candidates=(
        "$(/usr/libexec/java_home 2>/dev/null || true)"
        /opt/homebrew/opt/openjdk@21 /opt/homebrew/opt/openjdk
        /usr/local/opt/openjdk@21 /usr/local/opt/openjdk
        "/Applications/Android Studio.app/Contents/jbr/Contents/Home"
        "$HOME/android-studio/jbr" /opt/android-studio/jbr)

    for candidate in "${candidates[@]}"; do
        if [[ -n "$candidate" && -x "$candidate/bin/java" ]]; then
            export JAVA_HOME="$candidate"
            break
        fi
    done
fi

if [[ -z "${JAVA_HOME:-}" ]] && ! java -version >/dev/null 2>&1; then
    echo "android-apk: no JDK found; install one (JDK 17+) or set JAVA_HOME" >&2
    exit 1
fi

if [[ -n "${JAVA_HOME:-}" ]]; then
    java_bin="$JAVA_HOME/bin"
    command -v cygpath >/dev/null && java_bin="$(cygpath -u "$java_bin")"
    export PATH="$java_bin:$PATH"
fi

# On Windows apksigner is a .bat.
apksigner="$build_tools/apksigner"
[[ -f "$apksigner.bat" ]] && apksigner="$apksigner.bat"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

link_args=()

if [[ "$debug" == debug ]]; then
    link_args+=(--debug-mode)
fi

if [[ -n "$res" && -d "$res" ]]; then
    "$build_tools/aapt2" compile --dir "$res" -o "$work/res.zip"
    link_args+=(-R "$work/res.zip" --auto-add-overlay)
fi

"$build_tools/aapt2" link -o "$work/base.apk" --manifest "$manifest" \
    -I "$platform_jar" "${link_args[@]+"${link_args[@]}"}"

mkdir -p "$work/stage/lib/$abi"
cp "$library" "$work/stage/lib/$abi/"
# Git for Windows' bash has no zip.
if command -v zip >/dev/null; then
    (cd "$work/stage" && zip -qr "$work/base.apk" lib)
else
    jar uf "$work/base.apk" -C "$work/stage" lib
fi

"$build_tools/zipalign" -P 16 -f 4 "$work/base.apk" "$work/aligned.apk"

keystore="${EACP_ANDROID_KEYSTORE:-$HOME/.android/debug.keystore}"

if [[ ! -f "$keystore" ]]; then
    mkdir -p "$(dirname "$keystore")"
    keytool -genkeypair -keystore "$keystore" -storepass android \
        -alias androiddebugkey -keypass android -keyalg RSA -keysize 2048 \
        -validity 10000 -dname "CN=Android Debug,O=Android,C=US" >/dev/null
fi

mkdir -p "$(dirname "$out")"
"$apksigner" sign --ks "$keystore" --ks-pass pass:android \
    --key-pass pass:android --out "$out" "$work/aligned.apk"
rm -f "$out.idsig"

echo "$out"
