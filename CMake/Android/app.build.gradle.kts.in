plugins {
    id("com.android.application")
}

android {
    namespace = "@EACP_APK_PACKAGE@"
    compileSdk {
        version = release(@EACP_STUDIO_COMPILE_SDK@) {
            minorApiLevel = @EACP_STUDIO_COMPILE_SDK_MINOR@
        }
    }
    ndkVersion = "@EACP_STUDIO_NDK_VERSION@"

    defaultConfig {
        applicationId = "@EACP_APK_PACKAGE@"
        minSdk = @EACP_APK_MIN_SDK@
        targetSdk = @EACP_ANDROID_TARGET_SDK@
        versionCode = @EACP_APK_VERSION_CODE@
        versionName = "@EACP_APK_VERSION_NAME@"

        ndk {
            abiFilters += listOf(@EACP_STUDIO_ABIS@)
        }

        externalNativeBuild {
            cmake {
                targets += "@EACP_APK_LIB_NAME@"
                arguments += listOf(@EACP_STUDIO_CMAKE_ARGUMENTS@)
            }
        }
    }

    buildTypes {
        getByName("release") {
            // The debug key, so a release build installs as is. A Play upload
            // needs an upload key in a signingConfig of its own here.
            signingConfig = signingConfigs.getByName("debug")

            externalNativeBuild {
                cmake {
                    arguments += "-DCMAKE_BUILD_TYPE=Release"
                }
            }
        }
    }

    externalNativeBuild {
        cmake {
            path = file("@EACP_STUDIO_CMAKE_LISTS@")
        }
    }
@EACP_STUDIO_RES@}
