<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        package="@EACP_APK_PACKAGE@"
        android:versionCode="@EACP_APK_VERSION_CODE@"
        android:versionName="@EACP_APK_VERSION_NAME@">

    <uses-sdk android:minSdkVersion="@EACP_APK_MIN_SDK@"
            android:targetSdkVersion="@EACP_APK_TARGET_SDK@" />

    <!-- The Vulkan backend's floor: 1.3 with dynamic rendering. -->
    <uses-feature android:name="android.hardware.vulkan.version"
            android:version="0x403000" android:required="true" />
@EACP_APK_MANIFEST_ELEMENTS@

    <application android:label="@EACP_APK_LABEL@"
            @EACP_APK_ICON_ATTRIBUTE@
            android:hasCode="false"
            android:extractNativeLibs="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            @EACP_APK_APPLICATION_ATTRIBUTES@>
        <activity android:name="android.app.NativeActivity"
                android:exported="true"
                android:launchMode="singleTask"
                android:screenOrientation="@EACP_APK_ORIENTATION@"
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
                @EACP_APK_ACTIVITY_ATTRIBUTES@>
            <meta-data android:name="android.app.lib_name"
                    android:value="@EACP_APK_LIB_NAME@" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
