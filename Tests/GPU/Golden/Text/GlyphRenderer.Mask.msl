#include <metal_stdlib>
using namespace metal;

struct VertexIn
{
    float2 a0 [[attribute(0)]];
    float4 a1 [[attribute(1)]];
    float4 a2 [[attribute(2)]];
    float4 a3 [[attribute(3)]];
};

struct VertexOut
{
    float4 position [[position]];
    float2 v0;
    float4 v1;
};

struct Uniforms
{
    float2 u0;
    float2 u1;
};

vertex VertexOut vertexMain(VertexIn input [[stage_in]], constant Uniforms& uniforms [[buffer(16)]])
{
    float2 t0 = float2(((input.a1).x + ((input.a0).x * (input.a1).z)), ((input.a1).y + ((input.a0).y * (input.a1).w)));
    VertexOut output;
    output.position = float4(((((t0).x / (uniforms.u0).x) * 2.0) - 1.0), (1.0 - (((t0).y / (uniforms.u0).y) * 2.0)), 0.0, 1.0);
    output.v0 = float2((((input.a2).x + ((input.a0).x * (input.a2).z)) / (uniforms.u1).x), (((input.a2).y + ((input.a0).y * (input.a2).w)) / (uniforms.u1).y));
    output.v1 = input.a3;
    return output;
}

fragment float4 fragmentMain(VertexOut input [[stage_in]],
    texture2d<float> texture0 [[texture(0)]],
    sampler sampler0 [[sampler(0)]])
{
    return float4((input.v1).x, (input.v1).y, (input.v1).z, ((input.v1).w * (texture0.sample(sampler0, input.v0)).x));
}
