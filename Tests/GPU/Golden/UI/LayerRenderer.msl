#include <metal_stdlib>
using namespace metal;

struct VertexIn
{
    float2 a0 [[attribute(0)]];
};

struct VertexOut
{
    float4 position [[position]];
    float2 v0;
    float2 v1;
};

struct Uniforms
{
    float2 u0;
    float4 u1;
    float4 u2;
    float u3;
    float4 u4;
    float2 u5;
    float4 u6;
    float4 u7;
};

vertex VertexOut vertexMain(VertexIn input [[stage_in]], constant Uniforms& uniforms [[buffer(16)]])
{
    float2 t0 = float2(((input.a0).x * (uniforms.u1).z), ((input.a0).y * (uniforms.u1).w));
    float2 t1 = float2(((((uniforms.u4).x * (t0).x) + ((uniforms.u4).z * (t0).y)) + (uniforms.u5).x), ((((uniforms.u4).y * (t0).x) + ((uniforms.u4).w * (t0).y)) + (uniforms.u5).y));
    float2 t2 = float2(((uniforms.u1).x + (t1).x), ((uniforms.u1).y + (t1).y));
    VertexOut output;
    output.position = float4(((((t2).x / (uniforms.u0).x) * 2.0) - 1.0), (1.0 - (((t2).y / (uniforms.u0).y) * 2.0)), 0.0, 1.0);
    output.v0 = float2(((uniforms.u2).x + ((input.a0).x * (uniforms.u2).z)), ((uniforms.u2).y + ((input.a0).y * (uniforms.u2).w)));
    output.v1 = t2;
    return output;
}

fragment float4 fragmentMain(VertexOut input [[stage_in]],
    constant Uniforms& uniforms [[buffer(16)]],
    texture2d<float> texture0 [[texture(0)]],
    sampler sampler0 [[sampler(0)]],
    texture2d<float> texture1 [[texture(1)]],
    sampler sampler1 [[sampler(1)]])
{
    float4 t0 = texture0.sample(sampler0, input.v0);
    float3 t1 = ((t0).xyz / max((t0).w, 0.00195312));
    float2 t2 = ((input.v1 - (uniforms.u6).xy) * (uniforms.u6).zw);
    float2 t3 = abs((t2 - 0.5));
    return float4((t1).x, (t1).y, (t1).z, (((t0).w * uniforms.u3) * ((step((t3).x, 0.5) * step((t3).y, 0.5)) * (texture1.sample(sampler1, ((uniforms.u7).xy + (t2 * (uniforms.u7).zw)))).x)));
}
