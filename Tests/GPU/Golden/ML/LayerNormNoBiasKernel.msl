#include <metal_stdlib>
using namespace metal;

struct Uniforms
{
    uint u0;
    float u1;
    uint width;
    uint height;
};

kernel void computeMain(device const float* buffer0 [[buffer(0)]],
    device const float* buffer1 [[buffer(1)]],
    device float* buffer2 [[buffer(2)]],
    constant Uniforms& uniforms [[buffer(16)]],
    uint2 gid [[thread_position_in_grid]],
    uint simdLane [[thread_index_in_simdgroup]],
    uint simdIndex [[simdgroup_index_in_threadgroup]],
    uint simdCount [[simdgroups_per_threadgroup]])
{
    threadgroup float groupScratch[256];
    float v0 = 0.0;
    uint v1 = gid.x;
    while ((v1 < uniforms.u0))
    {
        v0 = (v0 + buffer0[((gid.y * uniforms.u0) + v1)]);
        v1 = (v1 + 256u);
    }
    float v2 = simd_sum(v0);
    if (simdLane == 0u)
        groupScratch[simdIndex] = v2;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    v2 = groupScratch[0];
    for (uint gr2 = 1u; gr2 < simdCount; ++gr2)
        v2 = v2 + groupScratch[gr2];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float v3 = 0.0;
    v1 = gid.x;
    while ((v1 < uniforms.u0))
    {
        float t0 = (buffer0[((gid.y * uniforms.u0) + v1)] - (v2 / float(uniforms.u0)));
        v3 = (v3 + (t0 * t0));
        v1 = (v1 + 256u);
    }
    float v4 = simd_sum(v3);
    if (simdLane == 0u)
        groupScratch[simdIndex] = v4;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    v4 = groupScratch[0];
    for (uint gr4 = 1u; gr4 < simdCount; ++gr4)
        v4 = v4 + groupScratch[gr4];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    v1 = gid.x;
    while ((v1 < uniforms.u0))
    {
        uint t1 = (gid.y * uniforms.u0);
        buffer2[(t1 + v1)] = (((buffer0[(t1 + v1)] - (v2 / float(uniforms.u0))) * rsqrt(((v4 / float(uniforms.u0)) + uniforms.u1))) * buffer1[v1]);
        v1 = (v1 + 256u);
    }
}
