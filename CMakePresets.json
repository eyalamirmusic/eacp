{
    "version": 6,
    "configurePresets": [
        {
            "name": "android",
            "displayName": "Android arm64-v8a, API 33, Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-android",
            "toolchainFile": "${sourceDir}/CMake/AndroidToolchain.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-33"
            }
        },
        {
            "name": "android-studio",
            "inherits": "android",
            "displayName": "Android Studio project in build-android-studio",
            "binaryDir": "${sourceDir}/build-android-studio/cmake",
            "cacheVariables": {
                "EACP_ANDROID_STUDIO_DIR": "${sourceDir}/build-android-studio",
                "CPM_SOURCE_CACHE": "${sourceDir}/build-android-studio/cpm"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "android",
            "configurePreset": "android"
        }
    ]
}
