#include <metal_stdlib>
using namespace metal;

struct Uniforms
{
    float u0;
    float u1;
    float u2;
    float u3;
    uint u4;
    uint count;
};

kernel void computeMain(device float* buffer0 [[buffer(0)]],
    constant Uniforms& uniforms [[buffer(16)]],
    uint gid [[thread_position_in_grid]])
{
    if (gid >= uniforms.count)
        return;
    float t0 = ((uniforms.u0 * exp((((float(gid) / uniforms.u3) * (uniforms.u2 - uniforms.u1)) + uniforms.u1))) * 6.28319);
    buffer0[gid] = cos(t0);
    buffer0[(uniforms.u4 + gid)] = sin(t0);
}
