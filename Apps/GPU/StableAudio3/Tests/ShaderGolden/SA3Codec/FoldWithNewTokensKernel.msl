#include <metal_stdlib>
using namespace metal;

struct Uniforms
{
    uint u0;
    uint u1;
    uint u2;
    uint u3;
    uint width;
    uint height;
};

kernel void computeMain(device const float* buffer0 [[buffer(0)]],
    device const float* buffer1 [[buffer(1)]],
    device float* buffer2 [[buffer(2)]],
    constant Uniforms& uniforms [[buffer(16)]],
    uint2 gid [[thread_position_in_grid]])
{
    if (gid.x >= uniforms.width || gid.y >= uniforms.height)
        return;
    uint t0 = (gid.y % uniforms.u2);
    buffer2[((gid.y * uniforms.u0) + gid.x)] = ((t0 < uniforms.u1) ? buffer0[((min((((gid.y / uniforms.u2) * uniforms.u1) + t0), (uniforms.u3 - 1u)) * uniforms.u0) + gid.x)] : buffer1[gid.x]);
}
