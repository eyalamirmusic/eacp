#include <metal_stdlib>
using namespace metal;

struct Uniforms
{
    uint u0;
    uint u1;
    uint u2;
    uint u3;
    uint width;
    uint height;
};

kernel void computeMain(device const float* buffer0 [[buffer(0)]],
    device float* buffer1 [[buffer(1)]],
    constant Uniforms& uniforms [[buffer(16)]],
    uint2 gid [[thread_position_in_grid]])
{
    if (gid.x >= uniforms.width || gid.y >= uniforms.height)
        return;
    uint t0 = (gid.y + (gid.x % uniforms.u1));
    uint t1 = (uniforms.u3 + uniforms.u2);
    buffer1[((gid.y * (uniforms.u0 * uniforms.u1)) + gid.x)] = (((t0 >= uniforms.u2) && (t0 < t1)) ? buffer0[(((min(max(t0, uniforms.u2), (t1 - 1u)) - uniforms.u2) * uniforms.u0) + (gid.x / uniforms.u1))] : 0.0);
}
