#include <metal_stdlib>
using namespace metal;

struct Uniforms
{
    uint u0;
    uint count;
};

kernel void computeMain(device const float* buffer0 [[buffer(0)]],
    device float* buffer1 [[buffer(1)]],
    constant Uniforms& uniforms [[buffer(16)]],
    uint gid [[thread_position_in_grid]])
{
    if (gid >= uniforms.count)
        return;
    uint t0 = (((gid / uniforms.u0) * uniforms.u0) * 2u);
    uint t1 = (gid % uniforms.u0);
    buffer1[gid] = (buffer0[(t0 + t1)] * sin((buffer0[((t0 + uniforms.u0) + t1)] * 3.14159)));
}
